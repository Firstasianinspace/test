{
  "name": "mini-crm",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:db": "node scripts/with-supabase-env.mjs vitest run --project db",
    "e2e": "node scripts/with-supabase-env.mjs playwright test",
    "format": "prettier --write .",
    "supabase": "supabase",
    "gen:types": "supabase gen types typescript --local > src/infrastructure/supabase/database.types.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.1",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.105.3",
    "clsx": "^2.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-router-dom": "^7.18.5",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "dotenv": "^18.0.9",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-boundaries": "^7.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "supabase": "^3.0.0",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
